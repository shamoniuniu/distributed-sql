DISTRIBUTED_SQL_COORDINATOR_HOST=127.0.0.1
DISTRIBUTED_SQL_COORDINATOR_PORT=8080
DISTRIBUTED_SQL_COORDINATOR_CATALOG_PATH=data/catalog.db
# Optional S3/MinIO settings. Local file:// paths require no credentials.
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_ACCESS_KEY=minioadmin
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_SECRET_KEY=minioadmin
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_BUCKET=distributed-sql
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_REGION=us-east-1
# DISTRIBUTED_SQL_COORDINATOR_OBJECT_STORE_SECURE=false
# DISTRIBUTED_SQL_COORDINATOR_REMOTE_TASK_AUTH_TOKEN=replace-with-a-random-secret
DISTRIBUTED_SQL_COORDINATOR_CANCELLATION_TIMEOUT_SECONDS=10
DISTRIBUTED_SQL_WORKER_HOST=127.0.0.1
DISTRIBUTED_SQL_WORKER_PORT=8091
DISTRIBUTED_SQL_WORKER_COORDINATOR_URL=http://127.0.0.1:8080
DISTRIBUTED_SQL_WORKER_HEARTBEAT_INTERVAL_SECONDS=2
DISTRIBUTED_SQL_WORKER_MEMORY_LIMIT_BYTES=67108864
DISTRIBUTED_SQL_WORKER_TEMP_DIRECTORY=data/tmp
# Workers need the same S3/MinIO endpoint, credentials, bucket, and region.
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_ACCESS_KEY=minioadmin
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_SECRET_KEY=minioadmin
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_BUCKET=distributed-sql
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_REGION=us-east-1
# DISTRIBUTED_SQL_WORKER_OBJECT_STORE_SECURE=false
# DISTRIBUTED_SQL_WORKER_REMOTE_TASK_AUTH_TOKEN=replace-with-the-same-random-secret
DISTRIBUTED_SQL_WORKER_CANCELLATION_TIMEOUT_SECONDS=5
DISTRIBUTED_SQL_COORDINATOR_LEASE_TTL_SECONDS=6
DISTRIBUTED_SQL_LOCAL_WORKER_COUNT=2
